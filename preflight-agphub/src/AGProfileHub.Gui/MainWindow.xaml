<Window x:Class="AGProfileHub.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity 配置中心"
        Height="680"
        Width="1180"
        MinHeight="500"
        MinWidth="980"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#243247"
        Background="#F5F7FB">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#243247" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#243247" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="Foreground" Value="#526277" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,12" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel x:Name="MainPanel" Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Antigravity 配置中心" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="管理配置、启动方式与运行状态" Foreground="#64748B" Margin="0,4,0,16" />
            <Border Padding="12" Margin="0,0,0,16" Background="#FFF8E7"
                    BorderBrush="#EAD5A0" BorderThickness="1" CornerRadius="6">
                <TextBlock Text="登录始终使用 Antigravity / Google 官方流程。普通 Direct 无需 Sandboxie，不支持多配置并发账号隔离；Sandboxie 为可选实验后端，多账号隔离仍需人工登录验证。"
                           TextWrapping="Wrap" Foreground="#73581E" />
            </Border>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="新建配置" Click="Create_Click" Margin="0,0,8,0"
                        Background="#E8F0FF" BorderBrush="#9DBBEE" Foreground="#2456A6" />
                <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button Content="诊断" Click="Doctor_Click" Margin="0,0,8,0" />
                <Button Content="设置" Click="Settings_Click" Margin="0,0,16,0" />
                <Menu Background="Transparent" VerticalAlignment="Center" Foreground="#243247">
                    <MenuItem Header="批量操作" Padding="10,7">
                        <MenuItem x:Name="LaunchAllMenuItem" Header="启动全部" Click="LaunchAll_Click"
                                  IsEnabled="False" ToolTipService.ShowOnDisabled="True" />
                        <MenuItem x:Name="StopAllMenuItem" Header="停止全部" Click="StopAll_Click" IsEnabled="False" />
                        <Separator />
                        <MenuItem x:Name="ForceStopAllMenuItem" Header="强制停止全部…" Click="ForceStopAll_Click"
                                  IsEnabled="False" Foreground="#B33A32" />
                    </MenuItem>
                    <MenuItem Header="数据与日志" Padding="10,7">
                        <MenuItem Header="打开数据目录" Click="OpenData_Click" />
                        <MenuItem Header="打开日志目录" Click="OpenLogs_Click" />
                    </MenuItem>
                </Menu>
            </WrapPanel>
            <TextBlock x:Name="LaunchAllHint" Text="正在读取配置…" Margin="0,0,0,12"
                       Foreground="#64748B" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,12,0,0"
                   Foreground="#526277" TextWrapping="Wrap" Text="准备就绪" />

        <Grid>
            <DataGrid x:Name="ProfilesGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8EDF4" BorderBrush="#DCE3ED"
                      Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#FAFBFD"
                      MinRowHeight="50">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配置名称" Binding="{Binding Name}" Width="1.2*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="ToolTip" Value="{Binding ProfileId}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="后端" Binding="{Binding BackendText}" Width="145"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StateText}" Width="78"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="状态说明" Binding="{Binding Detail}" Width="1.6*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PID" Binding="{Binding RootProcessId}" Width="64"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="工作区（元数据）" Binding="{Binding WorkspacePath}" Width="1.2*" MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="ToolTip" Value="{Binding WorkspacePath}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="操作" Width="204">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="启动" Tag="{Binding ProfileId}" Click="Launch_Click" Padding="10,5" Margin="0,0,6,0" />
                                    <Button Content="停止" Tag="{Binding ProfileId}" Click="Stop_Click" Padding="10,5" Margin="0,0,6,0" />
                                    <Button Content="更多" Click="More_Click" Padding="10,5">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                         IsEnabled="{Binding PlacementTarget.IsEnabled, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="重启" Click="Restart_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <MenuItem Header="强制停止…" Click="ForceStop_Click" Foreground="#B33A32"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <MenuItem Header="强制重启…" Click="ForceRestart_Click" Foreground="#B33A32"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <Separator />
                                                <MenuItem Header="工作区元数据…" Click="Workspace_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <MenuItem Header="重命名…" Click="Rename_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <MenuItem Header="打开配置数据目录" Click="Data_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <MenuItem Header="创建桌面快捷方式" Click="Shortcut_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                                <Separator />
                                                <MenuItem Header="移除配置…" Click="Remove_Click"
                                                          Tag="{Binding DataContext.ProfileId, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyState" Visibility="Collapsed" Background="#FFFFFF" Margin="1,44,1,1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24">
                    <TextBlock Text="还没有配置" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="新建一个普通 Direct 配置即可开始，无需安装 Sandboxie。需要实验性隔离时，可在新建对话框中选择 Sandboxie。"
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="#64748B" Margin="0,12,0,18" />
                    <Button Content="新建第一个配置" Click="Create_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
