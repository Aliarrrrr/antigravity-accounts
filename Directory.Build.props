<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="('$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifiers)' == 'win-x64') and '$(SelfContained)' == 'true' and ('$(MSBuildProjectName)' == 'AGProfileHub.Core' or '$(MSBuildProjectName)' == 'AGProfileHub.Cli' or '$(MSBuildProjectName)' == 'AGProfileHub.Gui')">$(MSBuildProjectDirectory)/packages.win-x64.lock.json</NuGetLockFilePath>
    <Version>0.5.0-next.4</Version>
  </PropertyGroup>
</Project>
