<Window x:Class="AGProfileHub.Gui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Antigravity Profile Hub Next · 实验版" Width="1160" Height="760" MinWidth="900" MinHeight="620" Background="#F4F6FA">
 <Grid Margin="24" Background="#F4F6FA">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Profile Hub Next" FontSize="28" FontWeight="SemiBold" Foreground="#182438"/>
   <TextBlock Margin="0,8,0,16" Text="独立应用状态 · 官方窗口手动登录 · 已登录实例可并行 · 授权按顺序完成 · 不提供 OS 沙箱" Foreground="#526078"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14" x:Name="Toolbar">
   <Button Content="创建 Profile" Click="Create_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="共享工作空间…" Click="SharedWorkspaces_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="应用路径" Click="Configure_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="探测兼容性" Click="Probe_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="兼容性 / 诊断" Click="Doctor_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="注册回调" Click="Register_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="还原回调" Click="Restore_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="日志目录" Click="Logs_Click" Margin="0,0,8,8" Padding="12,8"/>
  </WrapPanel>
  <DataGrid Grid.Row="2" x:Name="ProfilesGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" Background="White" RowHeight="42" HeadersVisibility="Column">
   <DataGrid.Columns>
    <DataGridTextColumn Header="账号标签（手填）" Binding="{Binding Name}" Width="180"/>
    <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="100"/>
    <DataGridTextColumn Header="Workspace（保存路径）" Binding="{Binding WorkspacePath}" Width="220"/>
    <DataGridTextColumn Header="诊断" Binding="{Binding Detail}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="3" x:Name="Actions" Margin="0,14,0,8">
   <Button Content="启动" Click="Launch_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="关闭" Click="Stop_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="强制停止…" Click="Force_Click" Margin="0,0,8,8" Padding="12,8" Foreground="#B42318"/>
   <Button Content="准备登录" Click="Login_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="取消等待" Click="CancelLogin_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="账号标签" Click="Rename_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="Workspace" Click="Workspace_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="桥接范围" Click="Bridge_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="配置继承预览" Click="Inherit_Click" Margin="0,0,8,8" Padding="12,8"/>
   <Button Content="快捷方式" Click="Shortcut_Click" Margin="0,0,8,8" Padding="12,8"/>
  </WrapPanel>
  <TextBox Grid.Row="4" x:Name="Output" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#182438" Foreground="#EDF2FA" Padding="12" FontFamily="Consolas" Text="实验版；完整人工验收尚未完成。先配置应用路径并探测兼容性。Workspace 打开无已验证接口，当前仅保存路径。"/>
 </Grid>
</Window>
