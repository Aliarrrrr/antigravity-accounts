<Window x:Class="AGProfileHub.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Profile Hub"
        Height="640"
        Width="1080"
        MinHeight="480"
        MinWidth="820"
        Background="#F7F8FA">
    <DockPanel x:Name="MainPanel" Margin="18">
        <Border DockPanel.Dock="Top"
                Padding="12"
                Margin="0,0,0,12"
                Background="#FFF4D6"
                BorderBrush="#E7C46A"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock Text="Authentication stays in official Antigravity / Google flow. Concurrent Google-account profiles are unsupported on Desktop 2.12.2 after failed manual isolation validation."
                       TextWrapping="Wrap"
                       Foreground="#624B00" />
        </Border>

        <WrapPanel DockPanel.Dock="Top"
                    Margin="0,0,0,12">
            <Button Content="+ Create profile" Click="Create_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="LaunchAllButton" Content="Launch all" Click="LaunchAll_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Stop all" Click="StopAll_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Force stop all" Click="ForceStopAll_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Doctor" Click="Doctor_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Settings" Click="Settings_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Open data" Click="OpenData_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Open logs" Click="OpenLogs_Click" Padding="12,6" />
        </WrapPanel>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   Margin="0,12,0,0"
                   Foreground="#555555"
                   TextWrapping="Wrap" />

        <DataGrid x:Name="ProfilesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="1.4*" />
                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="0.9*" />
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="ToolTip" Value="{Binding Detail}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding RootProcessId}" Width="0.7*" />
                <DataGridTextColumn Header="Workspace" Binding="{Binding WorkspacePath}" Width="2.2*" />
                <DataGridTemplateColumn Header="Actions" Width="4.8*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel>
                                <Button Content="Launch" Tag="{Binding ProfileId}" Click="Launch_Click" Margin="2" Padding="8,3" />
                                <Button Content="Stop" Tag="{Binding ProfileId}" Click="Stop_Click" Margin="2" Padding="8,3" />
                                <Button Content="Force stop" Tag="{Binding ProfileId}" Click="ForceStop_Click" Margin="2" Padding="8,3" />
                                <Button Content="Restart" Tag="{Binding ProfileId}" Click="Restart_Click" Margin="2" Padding="8,3" />
                                <Button Content="Force restart" Tag="{Binding ProfileId}" Click="ForceRestart_Click" Margin="2" Padding="8,3" />
                                <Button Content="Workspace" Tag="{Binding ProfileId}" Click="Workspace_Click" Margin="2" Padding="8,3" />
                                <Button Content="Rename" Tag="{Binding ProfileId}" Click="Rename_Click" Margin="2" Padding="8,3" />
                                <Button Content="Data" Tag="{Binding ProfileId}" Click="Data_Click" Margin="2" Padding="8,3" />
                                <Button Content="Shortcut" Tag="{Binding ProfileId}" Click="Shortcut_Click" Margin="2" Padding="8,3" />
                                <Button Content="Remove" Tag="{Binding ProfileId}" Click="Remove_Click" Margin="2" Padding="8,3" />
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
