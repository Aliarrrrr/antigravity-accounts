<Window x:Class="AGProfileHub.Gui.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/app.ico"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.SurfaceAlt}">
    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                       Style="{StaticResource SecondaryText}" Margin="0,0,0,12"/>
            <TextBox x:Name="InputBox" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource BaseButton}"
                        Padding="16,6" Margin="0,0,8,0"/>
                <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}"
                        Padding="16,6" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
